# ---------------------------------------------------------------------------
# BOOTSTRAP (first time only — bucket does not exist yet)
# ---------------------------------------------------------------------------
#   cd terraform/infrastructure/s3_state
#   terraform init -backend=false -input=false
#   terraform apply -var-file=../../env/dev.core.tfvars -var-file=dev.tfvars
#
# ---------------------------------------------------------------------------
# AFTER APPLY — store this root's state inside the bucket you just created
# ---------------------------------------------------------------------------
#   terraform init -migrate-state -backend-config=backend.hcl
#
# Use the SAME bucket_name as in dev.tfvars. Add dynamodb_table when the
# lock table exists (terraform/infrastructure/dynamodb).

bucket  = "YOUR_UNIQUE_BUCKET_NAME_FROM_DEV_TFVARS"
key     = "ngx-platform-hub/dev/infrastructure/s3-state/terraform.tfstate"
region  = "us-east-1"
encrypt = true
# dynamodb_table = "ngx-platform-hub-dev-terraform-locks"
